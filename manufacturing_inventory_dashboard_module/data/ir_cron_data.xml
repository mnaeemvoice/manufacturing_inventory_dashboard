<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE odoo SYSTEM "odoo.dtd">
<odoo>
    <data noupdate="1">
        <!-- Scheduled action to send daily manufacturing updates -->
        <record id="ir_cron_daily_mo_summary" model="ir.cron">
            <field name="name">Daily Manufacturing Order Summary</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="state">code</field>
            <field name="code">model.action_send_daily_mo_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <!-- Scheduled action for stock alerts -->
        <record id="ir_cron_hourly_stock_alerts" model="ir.cron">
            <field name="name">Hourly Low Stock Alerts</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="state">code</field>
            <field name="code">model.action_check_low_stock_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>