<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE odoo SYSTEM "odoo.dtd">
<odoo>

    <!-- Extend res.users form -->
    <record id="view_users_form_dashboard_preferences" model="ir.ui.view">
        <field name="name">res.users.form.dashboard.preferences</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Dashboard Preferences">
                    <group>
                        <group string="Visible KPIs">
                            <field name="dashboard_kpi_visibility_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <div class="text-muted">
                                Leave empty to show all default KPIs.
                            </div>
                        </group>
                        <group string="Visible Charts">
                            <field name="dashboard_chart_visibility_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <div class="text-muted">
                                Leave empty to show all default charts.
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="dashboard_dark_mode"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Server action to open dashboard preferences for current user -->
    <record id="server_action_open_dashboard_preferences" model="ir.actions.server">
        <field name="name">My Dashboard Preferences</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
action = model.browse(env.uid).action_open_dashboard_preferences()
        </field>
    </record>

</odoo>